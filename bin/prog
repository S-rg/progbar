#!/usr/bin/env python3
"""prog: run a command under a pseudo-terminal, report its progress to progd.

    prog [--name NAME] [--source SRC] -- cmd args...
    prog [--name NAME] [--source SRC] -c 'shell command string'
    prog --tail logs/run.log -c 'python job.py > logs/run.log 2>&1'

--tail FILE follows FILE for progress too (read from the start, for `>` redirects);
--tail-end FILE only reads what's appended after prog starts (for `>>` redirects).

The command thinks it has a real terminal, so tqdm / pip / rsync / curl / cargo
draw their bars. prog parses those bars and POSTs the latest state to progd
(PROGD_URL, default http://127.0.0.1:7777) at most once per second, plus a
heartbeat. Output is passed through with carriage-return spam collapsed and
ANSI escapes stripped, so whoever reads stdout (e.g. Claude) gets clean text.
Exit status is the command's exit status. If progd is down, nothing breaks.
"""
import codecs, errno, fcntl, json, os, pty, re, select, shlex, signal, socket
import struct, subprocess, sys, termios, threading, time, urllib.request

def _conf():
    c = {}
    try:
        with open(os.path.expanduser("~/.config/progbar/env")) as f:
            for ln in f:
                ln = ln.strip()
                if ln and not ln.startswith("#") and "=" in ln:
                    k, v = ln.split("=", 1)
                    c[k.strip()] = v.strip()
    except OSError:
        pass
    c.update(os.environ)
    return c


CONF = _conf()
_listen = (CONF.get("PROGD_LISTEN") or "127.0.0.1:7777").split(",")[0].strip()
URL = (CONF.get("PROGD_URL") or f"http://{_listen}").rstrip("/") + "/api/update"
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # progd is local/tailnet: never via proxy
SEND_EVERY = 1.0
HEARTBEAT = 15.0

ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]|[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
# tqdm:  " 45%|████▌     | 450/1000 [00:12<00:15, 36.1it/s]"
TQDM = re.compile(r"(\d{1,3})%\|[^|]*\|\s*([\d.]+\s?[kMGTP]?i?B?)/([\d.]+\s?[kMGTP]?i?B?)\s*\[([\d:]+)<([\d:?]+)(?:,\s*([^\]]+))?\]")
PCT = re.compile(r"(?<![\w.])(\d{1,3}(?:\.\d+)?)\s?%")
FRAC = re.compile(r"(?i)(?:\b(?:step|epoch|batch|iter(?:ation)?|it|file|item|chunk|shard|page|request|test|task|job)s?\b\s*[:#]?\s*|\]\s*|\[\s*|\()(\d+)\s*/\s*(\d+)\b")
# Any "label: N/M" or "label N/M" (e.g. "competitions: 250/6889", "matches 12/300").
# The separator after the label is required (so paths like x/12/34 don't match),
# and the second number must not continue into a date or path (2024/01/05, 1/2/3).
GENERIC_FRAC = re.compile(r"\b[A-Za-z][\w\-]*(?::\s*|\s+)(\d+)\s*/\s*(\d+)(?![\d/.\-:])")
RATE = re.compile(r"(\d+(?:\.\d+)?\s?(?:[kKMGT]i?)?(?:B|b|it|items?|files?|samples?|tok(?:ens)?)/s)")
ETA = re.compile(r"(?i)\beta[:\s]+([\d:hms ]+?)(?=\s|$|,)|<([\d:]+),")


def parse(frame):
    """Return dict of progress fields found in one frame of text, or None."""
    m = TQDM.search(frame)
    if m:
        out = {"pct": float(m.group(1)), "cur": m.group(2).strip(), "total": m.group(3).strip(), "eta": m.group(5)}
        if m.group(6):
            out["rate"] = m.group(6).strip()
        return out
    out = {}
    pcts = [float(p) for p in PCT.findall(frame) if 0 <= float(p) <= 100]
    if pcts:
        out["pct"] = pcts[-1]
    for rx in (FRAC, GENERIC_FRAC):
        fr = [(int(a), int(b)) for a, b in rx.findall(frame)]
        fr = [(a, b) for a, b in fr if 0 < b and a <= b]
        if fr:
            cur, tot = fr[-1]
            out["cur"], out["total"] = str(cur), str(tot)
            out.setdefault("pct", round(100.0 * cur / tot, 1))
            break
    if not out:
        return None
    r = RATE.search(frame)
    if r:
        out["rate"] = r.group(1)
    e = ETA.search(frame)
    if e:
        out["eta"] = (e.group(1) or e.group(2) or "").strip()
    return out


def follow(path, from_end, on_frame, stop, poll=0.5, max_chunk=65536):
    """Parse progress from a log file the command writes to (e.g. `> run.log`).

    Waits for the file to appear, handles truncation (the shell's `>` truncates it
    just after prog starts), and only looks at the newest max_chunk bytes per poll,
    so huge logs stay cheap.
    """
    pos = None
    partial = ""

    def drain(final=False):
        nonlocal pos, partial
        try:
            size = os.path.getsize(path)
        except OSError:
            return
        if pos is None:
            pos = size if from_end else 0
        if size < pos:  # truncated / rotated
            pos, partial = 0, ""
        if size == pos:
            if final and partial.strip():
                on_frame(partial)
            return
        start = max(pos, size - max_chunk)
        if start > pos:
            partial = ""  # skipped ahead; drop the broken line
        try:
            with open(path, "rb") as f:
                f.seek(start)
                data = f.read(size - start)
        except OSError:
            return
        pos = start + len(data)
        text = partial + ANSI.sub("", data.decode("utf-8", "replace"))
        frames = re.split(r"[\r\n]", text)
        partial = "" if final else frames.pop()
        # only the latest few frames matter for "current progress"
        for fr in [f for f in frames if f.strip()][-20:]:
            on_frame(fr)
        if final and partial.strip():
            on_frame(partial)

    while not stop.wait(poll):
        drain()
    drain(final=True)


class Reporter:
    def __init__(self, info):
        self.info = info
        self.state = {}
        self.dirty = True
        self.last_sent = 0.0
        self.lock = threading.Lock()
        self.stop = threading.Event()
        self.t = threading.Thread(target=self.loop, daemon=True)
        self.t.start()

    def update(self, **kw):
        with self.lock:
            for k, v in kw.items():
                if v is not None and self.state.get(k) != v:
                    self.state[k] = v
                    self.dirty = True

    def post(self, payload, timeout=0.5):
        try:
            req = urllib.request.Request(URL, data=json.dumps(payload).encode(),
                                         headers={"Content-Type": "application/json"}, method="POST")
            OPENER.open(req, timeout=timeout).close()
            return True
        except Exception:
            return False

    def snapshot(self):
        with self.lock:
            p = dict(self.info)
            p.update(self.state)
            self.dirty = False
            return p

    def loop(self):
        while not self.stop.wait(SEND_EVERY):
            now = time.time()
            if self.dirty or now - self.last_sent >= HEARTBEAT:
                self.post(self.snapshot())
                self.last_sent = now

    def finish(self, code):
        self.stop.set()
        self.update(state="done" if code == 0 else "failed", exit=code)
        self.post(self.snapshot(), timeout=2)


def main():
    argv = sys.argv[1:]
    name = os.environ.get("PROG_NAME")
    source = os.environ.get("PROG_SOURCE", "claude" if os.environ.get("CLAUDECODE") else "shell")
    shell_cmd = None
    tails = []  # (path, from_end)
    while argv:
        a = argv[0]
        if a == "--name" and len(argv) > 1:
            name, argv = argv[1], argv[2:]
        elif a in ("--tail", "--tail-end") and len(argv) > 1:
            tails.append((argv[1], a == "--tail-end"))
            argv = argv[2:]
        elif a == "--source" and len(argv) > 1:
            source, argv = argv[1], argv[2:]
        elif a == "-c" and len(argv) > 1:
            shell_cmd, argv = argv[1], argv[2:]
            break
        elif a == "--":
            argv = argv[1:]
            break
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            break
    if shell_cmd is not None:
        shell = os.environ.get("PROG_SHELL") or os.environ.get("SHELL") or "/bin/bash"
        cmd, display = [shell, "-c", shell_cmd], shell_cmd
    elif argv:
        cmd, display = argv, shlex.join(argv)
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2

    # Already inside a prog run: don't nest, just exec.
    if os.environ.get("PROG_ACTIVE"):
        os.execvp(cmd[0], cmd)

    host = CONF.get("PROGD_HOST") or socket.gethostname()
    start_ms = int(time.time() * 1000)
    info = {"id": f"{host}-{os.getpid()}-{start_ms}", "name": (name or display)[:120],
            "cmd": display[:500], "cwd": os.getcwd(), "source": source, "start": start_ms, "state": "running"}
    rep = Reporter(info)

    master, slave = pty.openpty()
    try:
        cols = int(os.environ.get("PROG_COLUMNS", "160"))
        fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 50, cols, 0, 0))
    except OSError:
        pass
    env = dict(os.environ, PROG_ACTIVE="1", PAGER="cat", GIT_PAGER="cat", MANPAGER="cat",
               PYTHONUNBUFFERED="1", TERM=os.environ.get("TERM") if os.environ.get("TERM") not in (None, "", "dumb") else "xterm-256color")

    def child_setup():
        os.setsid()
        try:
            fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
        except OSError:
            pass

    try:
        proc = subprocess.Popen(cmd, stdin=None, stdout=slave, stderr=slave, env=env,
                                preexec_fn=child_setup, close_fds=True)
    except OSError as e:
        print(f"prog: {cmd[0]}: {e.strerror}", file=sys.stderr)
        rep.finish(127)
        return 127
    # Keep our copy of the slave open. If the command sends all its output to a file
    # (`> run.log 2>&1`), nothing else holds the pty; closing it would make reads hit
    # EIO at once and the pty hangup would SIGHUP the still-running command.
    # So we stop on process exit instead of on EIO.

    def forward(sig, _frame):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            pass
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, forward)

    out = sys.stdout.buffer
    dec = codecs.getincrementaldecoder("utf-8")(errors="replace")
    cur = ""    # current frame (text since last \r or \n)
    last = ""   # last non-empty frame on this line, ended by \r (an overwritten bar)
    pending = ""  # trailing \r of a \r\n split across reads

    def on_frame(frame):
        frame = frame.strip()
        if not frame:
            return
        p = parse(frame)
        rep.update(**(p or {}), line=frame[:300])

    tail_stop = threading.Event()
    tail_threads = []
    for path, from_end in tails:
        path = os.path.abspath(os.path.expandvars(os.path.expanduser(path)))
        t = threading.Thread(target=follow, args=(path, from_end, on_frame, tail_stop), daemon=True)
        t.start()
        tail_threads.append(t)

    def feed(text):
        nonlocal cur, last
        emit = []
        for seg in re.split(r"(\r|\n)", text):
            if seg == "\n":
                final = cur if cur.strip() else last
                on_frame(final)
                emit.append(final.rstrip())
                cur = last = ""
            elif seg == "\r":
                if cur.strip():
                    on_frame(cur)
                    last = cur
                cur = ""
            elif seg:
                cur += seg
                if len(cur) > 8192:
                    cur = cur[-4096:]
        if cur.strip():
            on_frame(cur)  # live view of the frame being drawn
        if emit:
            out.write(("\n".join(emit) + "\n").encode())
            out.flush()

    exited_at = None
    while True:
        try:
            ready, _, _ = select.select([master], [], [], 0.25)
        except InterruptedError:
            continue
        if not ready:
            if exited_at is None and proc.poll() is not None:
                exited_at = time.time()
            if exited_at is not None:
                break  # child gone and output drained
            continue
        try:
            chunk = os.read(master, 65536)
        except OSError as e:
            if e.errno == errno.EINTR:
                continue
            break
        if not chunk:
            break
        text = pending + dec.decode(chunk)
        pending = ""
        if text.endswith("\r"):
            text, pending = text[:-1], "\r"
        feed(ANSI.sub("", text.replace("\r\n", "\n")))
        # a background grandchild may keep writing forever; stop 1s after the child exits
        if exited_at is None and proc.poll() is not None:
            exited_at = time.time()
        if exited_at is not None and time.time() - exited_at > 1.0:
            break
    os.close(slave)
    os.close(master)
    feed(ANSI.sub("", (pending + dec.decode(b"", final=True)).replace("\r\n", "\n")))
    final = cur if cur.strip() else last
    if final.strip():
        out.write((final.rstrip() + "\n").encode())
        out.flush()

    code = proc.wait()
    tail_stop.set()
    for t in tail_threads:
        t.join(timeout=2)
    if code < 0:
        code = 128 - code
    rep.finish(code)
    return code


if __name__ == "__main__":
    sys.exit(main())
